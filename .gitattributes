# 统一换行符：保证 Windows 批处理在克隆/下载后仍是 CRLF，可在 cmd 中直接运行
*.bat      text eol=crlf
*.cmd      text eol=crlf

# 脚本与文本文件使用 LF
*.command  text eol=lf
*.sh       text eol=lf
*.py       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf

# 二进制资源：不做任何换行或编码转换
*.wasm     binary
*.task     binary
*.ttf      binary
*.otf      binary
*.m4a      binary
*.wav      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.ico      binary
